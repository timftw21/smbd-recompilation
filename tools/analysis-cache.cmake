file(READ "${ROOT}/knowledge/supported_target.json" registry)
string(JSON expected GET "${registry}" targets 0 file_sha256)
file(SHA256 "${IMAGE}" image_hash)
string(TOUPPER "${image_hash}" image_hash)
if(NOT image_hash STREQUAL expected)
    message(FATAL_ERROR "Executable SHA-256 differs from the supported target")
endif()
file(READ "${DIRECTORY}/summary.json" summary)
string(JSON hash GET "${summary}" sha256)
string(JSON timed_out GET "${summary}" analysis_timed_out)
if(timed_out OR NOT hash STREQUAL expected)
    message(FATAL_ERROR "Ghidra analysis did not finish for the verified executable")
endif()
set(fields export_script_sha256 code_evidence_sha256)
set(paths tools/ghidra/ExportProgram.java knowledge/non_code_entries.json)
foreach(field path IN ZIP_LISTS fields paths)
    file(SHA256 "${ROOT}/${path}" digest)
    string(TOUPPER "${digest}" digest)
    if(RECORD)
        string(JSON summary SET "${summary}" ${field} "\"${digest}\"")
    else()
        string(JSON saved GET "${summary}" ${field})
        if(NOT saved STREQUAL digest)
            message(FATAL_ERROR "Analysis inputs changed")
        endif()
    endif()
endforeach()
if(RECORD)
    file(WRITE "${DIRECTORY}/summary.json" "${summary}\n")
endif()
