#pragma once
#include <cstdint>
#include <array>
#include <string_view>
namespace smbd {
struct StaticCallTable {
    std::uint32_t site, proof_address;
    std::string_view prefix;
    std::uint32_t start, end, stride;
    bool jump, tail;
    std::uint32_t slot;
};
inline constexpr StaticCallTable static_call_tables[] = {
@static_call_tables@};
struct EntryTable {std::uint32_t owner;std::string_view prefix;std::uint32_t start,end,stride;};
inline constexpr EntryTable entry_tables[] = {
@entry_tables@};
struct CallbackSlotTarget {std::uint32_t slot,literal;};
inline constexpr std::array<CallbackSlotTarget,@callback_slot_count@> callback_slot_targets = {{
@callback_slot_targets@}};
struct TablePointerSource {
    std::uint32_t source,proof_address;
    std::string_view prefix;
    std::uint32_t table;
    bool global,object,load;
};
inline constexpr std::array<TablePointerSource,@pointer_source_count@> table_pointer_sources = {{
@table_pointer_sources@}};
}
