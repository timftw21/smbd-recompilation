#pragma once
#include <array>
#include <cstdint>
#include <string_view>

namespace smbd {
struct CallbackAbi {
    std::uint32_t site, address, ordinal, argument_count;
    std::string_view prefix;
    std::array<unsigned, 4> callbacks;
    std::array<int, 4> offsets;
    unsigned count;
};
inline constexpr std::array callback_abis{
@callback_abis@};
struct CallbackPreserver {
    std::uint32_t address, mask;
    std::string_view prefix;
    std::uint32_t site;
};
inline constexpr std::array callback_preservers{
@callback_preservers@};
struct CallbackStackPreserver {
    std::uint32_t address, index_min, index_max;
    std::string_view prefix;
};
inline constexpr std::array callback_stack_preservers{
@callback_stack_preservers@};
struct CallbackFactory {
    std::uint32_t address;
    std::string_view prefix;
    std::array<std::uint32_t,4> fields;
    unsigned count;
};
inline constexpr std::array callback_factories{
@callback_factories@};
}
